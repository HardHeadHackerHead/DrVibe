{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "window-settings",
  "description": "The sensitive Dr. Vibe commands the settings window uses (network as the linked device, Claude Code hooks, the AI generator, local data). Every other window is refused them.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-api-request",
    "allow-api-poll",
    "allow-api-ack",
    "allow-api-send-events",
    "allow-api-send-visit",
    "allow-api-update-privacy",
    "allow-api-collection",
    "allow-api-set-equipped",
    "allow-api-send-recap",
    "allow-api-submit-design",
    "allow-sync-profile",
    "allow-get-last-sync",
    "allow-start-device-link",
    "allow-disconnect-profile",
    "allow-set-web-base-override",
    "allow-error-reports-set-enabled",
    "allow-install-claude-code-hooks",
    "allow-uninstall-claude-code-hooks",
    "allow-set-hook-paused"
  ]
}
