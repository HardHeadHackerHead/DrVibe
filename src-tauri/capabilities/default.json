{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for Dr. Vibe",
  "windows": ["main", "speech", "visitor", "toast", "settings", "setup-wizard", "dashboard", "session", "about", "achievements", "skills", "weekly", "today-wins", "personal-bests", "debug", "sprite-editor", "character-workshop", "make", "whats-new"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-outer-position",
    "core:window:allow-set-position",
    "core:window:allow-current-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-outer-size",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-size",
    "core:window:allow-destroy",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "store:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit-to",
    "dialog:default",
    "dialog:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
